{
  "name": "codemeld",
  "version": "1.0.0",
  "description": "AI-powered collaborative code editor with real-time sync",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "wrangler build",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "npm run build && wrangler publish",
    "type-check": "tsc --noEmit"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.114.16"
  },
  "dependencies": {
    "y-indexeddb": "^9.0.12"
  }
}
